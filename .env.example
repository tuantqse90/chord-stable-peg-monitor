# chord-stable-peg-monitor: copy to .env and edit. Every line is optional.

# Chain key or id.
CHAIN=bnb

# 1 = sign and send real transactions with your key. Anything else = paper.
LIVE=0

# Live only. A fresh hot wallet with small funds; the key never leaves this machine.
PRIVATE_KEY=

# Live only. Your RPC endpoint for the chain; transactions are dry-run and sent through it.
RPC_URL=

# Largest single entry.
MAX_TRADE_USD=25

# Entries are refused above this.
MAX_OPEN_POSITIONS=5

# Slippage sent with every quote (100 = 1%).
MAX_SLIPPAGE_BPS=100

# Quotes with more price impact are refused.
MAX_PRICE_IMPACT_PCT=1.5

# No new entries for the rest of the UTC day once realized losses reach this.
DAILY_LOSS_LIMIT_USD=50

# Starting cash of the paper book.
PAPER_BANKROLL_USD=1000

# Chord API base URL.
CHORD_API=https://api.getchord.xyz/v1

# Optional. Not needed for anything this agent calls.
CHORD_API_KEY=

# Client-side request cap per minute (anonymous callers get 60 per IP).
CHORD_RPM=50
